# ── 꼭 넣어야 하는 값 ─────────────────────────────
# 선생님 로그인에 쓰는 인증 코드 (선생님들끼리만 공유)
TEACHER_CODE=여기에-교사-코드
# 로그인 토큰 서명용 비밀값 (아무 긴 문자열, 예: openssl rand -hex 32 결과)
AUTH_SECRET=여기에-아주-긴-임의-문자열

# 무료 오픈소스 AI (Groq 무료 API 키: https://console.groq.com/keys)
AI_API_KEY=gsk_여기에-키

# ── 저장소: Vercel 대시보드에서 Upstash Redis를 연결하면 자동으로 들어가요 ──
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# (직접 만들었다면 아래 이름도 됩니다)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── 선택 ─────────────────────────────────────────
# 학생 로그인에 학교 코드를 추가로 받고 싶을 때
# STUDENT_CODE=
# 다른 무료/오픈소스 AI로 바꿀 때 (OpenAI 호환 주소)
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-120b
# 학생 한 명이 1분에 보낼 수 있는 질문 수 (기본 6)
# AI_PER_MINUTE=6
